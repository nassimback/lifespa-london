---
import Base from '../layouts/Base.astro';
---
<Base title={"Life Spa London | Expert skin and beauty care in South Ealing"} description={"Advanced facials, massage and laser hair removal from senior therapists in South Ealing, London. Over 25 years of experience."} style={2} page="index">
<main id="main">

  <!-- 1. Hero -->
  <section class="hero" aria-label="Welcome">
    <video autoplay muted loop playsinline preload="metadata" aria-hidden="true">
      <source src="assets/salon-video-2.mp4" type="video/mp4">
    </video>
    <div class="wrap hero-content">
      <p class="eyebrow reveal">South Ealing · Over 25 years</p>
      <h1 class="reveal d1">Expert skin and beauty care, <em>in South Ealing.</em></h1>
      <div class="hero-row">
        <div class="reveal d2">
          <p class="sub">Advanced facials, massage and laser hair removal from senior therapists, each with over 20 years' experience.</p>
          <div class="btn-row">
            <a class="btn btn--peach" href="#">Book Online <span class="arr">→</span></a>
            <a class="btn btn--ghost-light" href="#offer">View Treatments</a>
          </div>
        </div>
        <p class="hero-rating reveal d2"><span class="big">4.9</span><span class="stars" aria-hidden="true">★★★★★</span><small>from 47 Google reviews</small></p>
      </div>
    </div>
    <span class="scroll-cue" aria-hidden="true"></span>
  </section>

  <!-- 2. Popular this month -->
  <section class="section" id="popular" style="background:var(--cream)">
    <span class="glow" style="width:520px;height:520px;left:-160px;top:-120px"></span>
    <span class="sec-num" aria-hidden="true">01</span>
    <div class="wrap">
      <div class="head-row reveal">
        <div><p class="eyebrow">Most booked</p><h2>This month's <em>favourites</em></h2></div>
      </div>
      <div class="pop-grid">
        <a class="pop reveal" href="hydrafacial-v2.html">
          <div class="ph"><img src="assets/treatment-lauren.jpg" alt="HydraFacial treatment in progress" loading="lazy"><span class="tag"><b>From £149</b> · 30–60 min</span></div>
          <h3>HydraFacial</h3>
          <p>Deep cleanse, extract and hydrate in one treatment. Skin looks brighter straight away, with no downtime.</p>
          <span class="link-arrow">Explore HydraFacial</span>
        </a>
        <a class="pop reveal d1" href="environ-v2.html">
          <div class="ph"><img src="assets/facials.webp" alt="Client enjoying a facial" loading="lazy"><span class="tag"><b>From £85</b> · 60 min</span></div>
          <h3>Environ facials</h3>
          <p>Vitamin A facials that strengthen your skin over time, with a home-care plan made for you.</p>
          <span class="link-arrow">Explore Environ</span>
        </a>
        <a class="pop reveal d2" href="#">
          <div class="ph"><img src="assets/laser.webp" alt="Laser hair removal treatment" loading="lazy"><span class="tag"><b>From £30</b> · per area</span></div>
          <h3>Laser hair removal</h3>
          <p>Smoother skin that lasts, on face and body. Your journey starts with a patch test.</p>
          <span class="link-arrow">Explore Laser</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. What we offer -->
  <section class="section" id="offer">
    <span class="glow" style="width:460px;height:460px;right:-140px;bottom:-140px"></span>
    <span class="sec-num" aria-hidden="true">02</span>
    <div class="wrap">
      <div class="head-row reveal"><div><p class="eyebrow">Treatments</p><h2>What we <em>offer</em></h2></div></div>
      <div class="offer" data-tabs>
        <div class="tabs-list reveal" role="tablist" aria-label="Treatment groups">
          <button class="tab" role="tab" id="t1" aria-controls="p1">Facials &amp; Skin</button>
          <button class="tab" role="tab" id="t2" aria-controls="p2">Massage &amp; Lymphatic</button>
          <button class="tab" role="tab" id="t3" aria-controls="p3">Body</button>
          <button class="tab" role="tab" id="t4" aria-controls="p4">Hair Removal</button>
          <button class="tab" role="tab" id="t5" aria-controls="p5">Hands &amp; Feet</button>
        </div>
        <div class="reveal d1">
          <div class="tab-panel" role="tabpanel" id="p1" aria-labelledby="t1">
            <div class="ph"><img src="assets/hydrafacial-2.jpg" alt="HydraFacial scalp treatment" loading="lazy"></div>
            <h3>Facials &amp; Skin</h3>
            <p>Results-led facials from HydraFacial, Environ, CACI, Dermalogica and Elemis, plus Dermalux LED. We'll match the treatment to your skin.</p>
            <div class="tag-links"><a href="hydrafacial-v2.html">HydraFacial</a><a href="environ-v2.html">Environ</a><a href="#">CACI</a><a href="#">Dermalogica</a><a href="#">Elemis</a><a href="#">Dermalux LED</a></div>
            <div class="panel-actions"><a class="link-arrow" href="#">Which facial is right for me?</a><a class="link-arrow" href="#">View full menu</a></div>
          </div>
          <div class="tab-panel" role="tabpanel" id="p2" aria-labelledby="t2">
            <div class="ph"><img src="assets/massage-2.jpg" alt="Relaxing face massage" loading="lazy"></div>
            <h3>Massage &amp; Lymphatic</h3>
            <p>Swedish, aromatherapy and deep tissue massage, plus manual lymphatic drainage for face and body. The pressure is always set to suit you.</p>
            <div class="tag-links"><a href="#">Massage</a><a href="#">Lymphatic drainage</a></div>
            <div class="panel-actions"><a class="link-arrow" href="#">View full menu</a></div>
          </div>
          <div class="tab-panel" role="tabpanel" id="p3" aria-labelledby="t3">
            <div class="ph"><img src="assets/body-1.jpg" alt="Body treatment" loading="lazy"></div>
            <h3>Body</h3>
            <p>Scrubs, tanning and contouring treatments to smooth, firm and refresh.</p>
            <div class="tag-links"><a href="#">CACI Bottoms Up</a><a href="#">Elemis body treatments</a><a href="#">Salt scrub</a><a href="#">Moroccan tan</a><a href="#">Bioslimming</a></div>
            <div class="panel-actions"><a class="link-arrow" href="#">View full menu</a></div>
          </div>
          <div class="tab-panel" role="tabpanel" id="p4" aria-labelledby="t4">
            <div class="ph"><img src="assets/laser-2.webp" alt="Laser hair removal consultation" loading="lazy"></div>
            <h3>Hair Removal</h3>
            <p>Laser hair removal for longer-lasting results, and Lycon waxing for face and body.</p>
            <div class="tag-links"><a href="#">Laser hair removal</a><a href="#">Waxing</a></div>
            <div class="panel-actions"><a class="link-arrow" href="#">View full menu</a></div>
          </div>
          <div class="tab-panel" role="tabpanel" id="p5" aria-labelledby="t5">
            <div class="ph"><img src="assets/hands-feet.jpg" alt="Manicure in progress" loading="lazy"></div>
            <h3>Hands &amp; Feet</h3>
            <p>Manicures and pedicures with OPI.</p>
            <div class="tag-links"><a href="#">Manicure</a><a href="#">Pedicure</a></div>
            <div class="panel-actions"><a class="link-arrow" href="#">View full menu</a></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Made for you -->
  <section class="section" id="made-for-you" style="background:var(--cream);padding-top:clamp(70px,9vw,120px)">
    <span class="sec-num" aria-hidden="true">03</span>
    <div class="wrap">
      <div class="head-row reveal"><div><p class="eyebrow">Made for you</p></div></div>
      <div class="duo">
        <a class="made reveal" href="#">
          <div class="arch-wrap"><div class="arch" style="margin:0"><img src="assets/hydrafacial-1.jpg" alt="Teen skin facial" loading="lazy"></div></div>
          <h3 style="margin-top:30px">Teen <em>skin</em></h3>
          <p>Gentle, effective care for breakouts and oily skin, plus a simple routine to follow at home. Parents are welcome at the consultation. Under 16? Please call us before booking.</p>
          <span class="btn">Teen facials <span class="arr">→</span></span>
        </a>
        <a class="made reveal d1" href="#">
          <div class="arch-wrap"><div class="arch" style="margin:0"><img src="assets/men-1.jpg" alt="Facial treatment for men" loading="lazy"></div></div>
          <h3 style="margin-top:30px">For <em>men</em></h3>
          <p>Deep-cleansing facials, massage and hair removal, booked and done without fuss.</p>
          <span class="btn">Treatments for men <span class="arr">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- 5. Recognition -->
  <section class="recog grain" aria-label="Recognition">
    <span class="glow" style="width:600px;height:300px;left:50%;top:-120px;transform:translateX(-50%)"></span>
    <h2 class="reveal" style="position:relative">Trusted in South Ealing for <em>over 25 years</em></h2>
    <div class="marquee" aria-label="25+ years, 5,000+ happy clients, Senior therapists with 20+ years' experience, Verified HydraFacial provider, West Spa of the Year 2017, Highly Commended 2018 and 2019">
      <div class="marquee-track" aria-hidden="true">
        <span>25+ years</span><span>5,000+ happy clients</span><span>Senior therapists with 20+ years' experience</span><span>Verified HydraFacial provider</span><span>West Spa of the Year 2017</span><span>Highly Commended 2018 &amp; 2019</span>
        <span>25+ years</span><span>5,000+ happy clients</span><span>Senior therapists with 20+ years' experience</span><span>Verified HydraFacial provider</span><span>West Spa of the Year 2017</span><span>Highly Commended 2018 &amp; 2019</span>
      </div>
    </div>
    <div class="wrap row2" aria-label="Brands and awards">
      <img src="assets/logo-hydrafacial.png" alt="HydraFacial" style="height:40px">
      <img src="assets/logo-environ.png" alt="Environ">
      <span class="caci">CACI</span>
      <img src="assets/logo-dermalogica.png" alt="Dermalogica">
      <img src="assets/logo-elemis.png" alt="Elemis">
      <img src="assets/logo-lycon.png" alt="Lycon">
      <img class="awd" src="assets/award-2017.jpg" alt="The London Hair &amp; Beauty Awards 2017">
      <img class="awd" src="assets/award-2018.jpg" alt="The London Hair &amp; Beauty Awards, Highly Commended 2018">
      <img class="awd" src="assets/award-2019.jpg" alt="The London Hair &amp; Beauty Awards, Highly Commended 2019">
    </div>
  </section>

  <!-- 6. About Jo -->
  <section class="section" id="about">
    <span class="glow" style="width:420px;height:420px;right:-120px;top:10%"></span>
    <div class="wrap about">
      <div class="pic reveal">
        <!-- Stand-in portrait: replace assets/team-jo.jpg with the real photo of Jo. -->
        <img src="assets/team-jo.jpg" alt="Jo, owner of Life Spa London" loading="lazy">
      </div>
      <div class="reveal d1">
        <p class="eyebrow">Meet the owner</p>
        <h2>Hello, <em>I'm Jo</em></h2>
        <p class="lead">Life Spa has looked after South Ealing for over 25 years. I first joined as a student receptionist, came back as a client, trained as a beauty therapist and became the owner in 2016. Every treatment here starts with a short conversation, so you know exactly what you're booking and why.</p>
        <p class="sign" aria-hidden="true">Jo</p>
        <a class="link-arrow" href="#">Our story</a>
      </div>
    </div>
  </section>

  <!-- 7. Meet the team -->
  <section class="section" id="team" style="background:var(--cream)">
    <span class="sec-num" aria-hidden="true">04</span>
    <div class="wrap">
      <div class="head-row reveal">
        <h2>Meet the <em>team</em></h2>
        <p>Senior therapists who know skin, each with over 20 years' experience.</p>
      </div>
      <div class="team">
        <!-- Team photos are stock stand-ins: replace assets/team-*.jpg with the real portraits. -->
        <div class="member reveal"><div class="ph"><img src="assets/team-jo.jpg" alt="Jo, Owner" loading="lazy"></div><h3>Jo</h3><p>Owner</p></div>
        <div class="member reveal d1"><div class="ph"><img src="assets/team-nilani.jpg" alt="Nilani, Beauty Therapist" loading="lazy"></div><h3>Nilani</h3><p>Beauty Therapist</p></div>
        <div class="member reveal d2"><div class="ph"><img src="assets/team-katerina.jpg" alt="Katerina, Therapist" loading="lazy"></div><h3>Katerina</h3><p>Therapist</p></div>
        <div class="member reveal d1"><div class="ph"><img src="assets/team-soraya.jpg" alt="Soraya, Therapist" loading="lazy"></div><h3>Soraya</h3><p>Therapist</p></div>
        <div class="member reveal d2"><div class="ph"><img src="assets/team-ahlem.jpg" alt="Ahlem, Therapist" loading="lazy"></div><h3>Ahlem</h3><p>Therapist</p></div>
      </div>
      <p style="margin-top:48px;text-align:center"><a class="link-arrow" href="#">Meet everyone</a></p>
    </div>
  </section>

  <!-- 8. Reviews -->
  <section class="section dark grain" id="reviews">
    <span class="glow" style="width:500px;height:500px;left:-160px;bottom:-200px"></span>
    <div class="wrap">
      <div class="head-row reveal">
        <h2>What our <em>clients say</em></h2>
        <div class="score"><span class="big">4.9</span><div><span class="stars" aria-hidden="true">★★★★★</span><small>from 47 Google reviews</small></div></div>
      </div>
      <div class="reviews-v2">
        <figure class="rv reveal"><span class="stars" aria-label="5 stars">★★★★★</span><blockquote>The atmosphere was so calm and relaxing. The team gave info when needed, carried out their services the best they can including extra information after.</blockquote><cite>Elisha · HydraFacial and massage</cite></figure>
        <figure class="rv reveal d1"><span class="stars" aria-label="5 stars">★★★★★</span><blockquote>She takes the time to check how you’re feeling and adjusts the pressure exactly to your preference, making sure you are comfortable throughout the whole treatment.</blockquote><cite>Erentina Barjoti · Massage</cite></figure>
        <figure class="rv reveal d2"><span class="stars" aria-label="5 stars">★★★★★</span><blockquote>Jo was lovely and I found the facial really relaxing. My skin felt and looked amazing!</blockquote><cite>Caroline de Vivenot · Environ facial</cite></figure>
      </div>
      <p style="text-align:center"><a class="link-arrow" href="#">Read all reviews</a></p>
    </div>
  </section>

  <!-- 9. FAQs -->
  <section class="section" id="faqs">
    <div class="wrap faq">
      <div class="stick reveal"><p class="eyebrow">FAQs</p><h2>Good to <em>know</em></h2></div>
      <div class="accordion reveal d1">
        <div class="acc-item">
          <button class="acc-btn" aria-expanded="false" aria-controls="f1" id="fb1"><span class="acc-title">Do I need a consultation?</span><span class="acc-icon" aria-hidden="true"></span></button>
          <div class="acc-panel" id="f1" role="region" aria-labelledby="fb1"><div><div class="acc-body"><p>For most facials, no. Your therapist does a short skin check at the start of your appointment. Laser hair removal needs a patch test first.</p></div></div></div>
        </div>
        <div class="acc-item">
          <button class="acc-btn" aria-expanded="false" aria-controls="f2" id="fb2"><span class="acc-title">Which facial is right for me?</span><span class="acc-icon" aria-hidden="true"></span></button>
          <div class="acc-panel" id="f2" role="region" aria-labelledby="fb2"><div><div class="acc-body"><p>HydraFacial gives an instant glow and clearer pores. Environ builds long-term skin health with vitamin A. CACI lifts and firms. Dermalogica targets breakouts and sensitivity. Elemis pairs results with deep relaxation.</p><p><a class="link-arrow" href="#">Compare our facials</a></p></div></div></div>
        </div>
        <div class="acc-item">
          <button class="acc-btn" aria-expanded="false" aria-controls="f3" id="fb3"><span class="acc-title">Do you treat teenagers?</span><span class="acc-icon" aria-hidden="true"></span></button>
          <div class="acc-panel" id="f3" role="region" aria-labelledby="fb3"><div><div class="acc-body"><p>Yes. Our teen facials are gentle and focus on breakouts and oil control. Under 16s need a parent or guardian to book.</p></div></div></div>
        </div>
        <div class="acc-item">
          <button class="acc-btn" aria-expanded="false" aria-controls="f4" id="fb4"><span class="acc-title">How do I book?</span><span class="acc-icon" aria-hidden="true"></span></button>
          <div class="acc-panel" id="f4" role="region" aria-labelledby="fb4"><div><div class="acc-body"><p>Online at any time, through the Life Spa London app, or call <a href="tel:+442085675159">020 8567 5159</a>.</p></div></div></div>
        </div>
        <div class="acc-item">
          <button class="acc-btn" aria-expanded="false" aria-controls="f5" id="fb5"><span class="acc-title">What is your cancellation policy?</span><span class="acc-icon" aria-hidden="true"></span></button>
          <div class="acc-panel" id="f5" role="region" aria-labelledby="fb5"><div><div class="acc-body"><p>We ask for notice if you need to change or cancel an appointment, so we can offer your time to someone else. Please see our full policy for the details.</p><p><a class="link-arrow" href="#">Full cancellation policy</a></p></div></div></div>
        </div>
        <div class="acc-item">
          <button class="acc-btn" aria-expanded="false" aria-controls="f6" id="fb6"><span class="acc-title">Do you sell gift vouchers?</span><span class="acc-icon" aria-hidden="true"></span></button>
          <div class="acc-panel" id="f6" role="region" aria-labelledby="fb6"><div><div class="acc-body"><p>Yes, for any amount or treatment.</p><p><a class="link-arrow" href="#">Buy a gift voucher</a></p></div></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 10. Visit us -->
  <section class="section dark grain" id="visit">
    <span class="glow" style="width:520px;height:520px;right:-180px;top:-160px"></span>
    <div class="wrap visit">
      <div class="reveal">
        <p class="eyebrow">Find us</p>
        <h2>Visit us in <em>South Ealing</em></h2>
        <p>Unit 2, 35–39 South Ealing Road, London W5 4QT. A short walk from South Ealing station.</p>
        <table class="hours">
          <tbody>
            <tr><td>Monday</td><td>10am–6pm</td></tr>
            <tr><td>Tuesday–Friday</td><td>10am–8pm</td></tr>
            <tr><td>Saturday</td><td>10am–6pm</td></tr>
            <tr><td>Sunday</td><td>Closed</td></tr>
          </tbody>
        </table>
        <ul class="contact-lines">
          <li><a href="tel:+442085675159">020 8567 5159</a></li>
          <li>WhatsApp <a href="https://wa.me/447592792460">07592 792460</a></li>
          <li><a href="mailto:bookings@lifespalondon.co.uk">bookings@lifespalondon.co.uk</a></li>
        </ul>
        <div class="btn-row">
          <a class="btn btn--peach" href="#">Book Online <span class="arr">→</span></a>
          <a class="btn btn--ghost" href="https://maps.google.com/?q=35-39+South+Ealing+Road,+London+W5+4QT" target="_blank" rel="noopener">Get directions</a>
        </div>
      </div>
      <iframe class="reveal d1" title="Map of Life Spa London, South Ealing" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
        src="https://maps.google.com/maps?q=35-39+South+Ealing+Road,+London+W5+4QT&amp;output=embed"></iframe>
    </div>
  </section>
</main>
</Base>
