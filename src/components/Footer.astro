---
import { CONTACT, HOURS, type PageId } from '../data/site';
interface Props { page: PageId }
const { page } = Astro.props;
const anchor = (h: string) => (page === 'index' ? h : `index.html${h}`);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-top">
      <p class="foot-big" aria-hidden="true">Life Spa <em>London</em></p>
      <div class="foot-cta">
        <p>Expert skin and beauty care in South Ealing.</p>
        <div class="btn-row">
          <a class="btn btn--light" href="#">Book Now</a>
          <a class="btn btn--ghost-light" href={CONTACT.phoneHref}>Call {CONTACT.phone}</a>
        </div>
      </div>
    </div>

    <div class="foot-cols">
      <div>
        <h4>Visit</h4>
        <p>{CONTACT.addressLines[0]},<br>{CONTACT.addressLines[1]}</p>
        <a class="foot-link" href={CONTACT.mapsHref} target="_blank" rel="noopener">Get directions →</a>
      </div>
      <div>
        <h4>Opening hours</h4>
        <ul class="foot-hours">
          {HOURS.map(([d, h]) => <li><span>{d}</span><span>{h}</span></li>)}
        </ul>
      </div>
      <div>
        <h4>Menu</h4>
        <ul><li><a href={anchor('#offer')}>Treatments</a></li><li><a href="#">Teens</a></li><li><a href="#">Men</a></li><li><a href="#">Offers &amp; Gifts</a></li><li><a href={anchor('#about')}>About</a></li><li><a href={anchor('#visit')}>Contact</a></li></ul>
      </div>
      <div>
        <h4>Policies</h4>
        <ul><li><a href="#">Cancellation policy</a></li><li><a href="#">Privacy policy</a></li><li><a href="#">Terms</a></li></ul>
      </div>
      <div>
        <h4>Follow</h4>
        <ul><li><a href="#">Instagram</a></li><li><a href="#">Facebook</a></li><li><a href="#">TikTok</a></li></ul>
        <div class="badges-app">
          <a href="#" aria-label="Download on the App Store"><img src="assets/app-store.png" alt="Download on the App Store"></a>
          <a href="#" aria-label="Get it on Google Play"><img src="assets/google-play.png" alt="Get it on Google Play"></a>
        </div>
      </div>
    </div>

    <div class="legal"><span>© {year} Life Spa London</span><span><a href={CONTACT.phoneHref}>{CONTACT.phone}</a> · <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></span></div>
  </div>
</footer>
