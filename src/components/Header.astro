---
import { MENU, href, type PageId } from '../data/site';
interface Props { page: PageId }
const { page } = Astro.props;
const anchor = (h: string) => (page === 'index' ? h : `index.html${h}`);
---
<header class="site-header">
  <div class="header-inner">
    <a class="logo" href="index.html" aria-label="Life Spa London home"><img src="assets/logo.png" alt="Life Spa London"></a>
    <button class="menu-toggle" aria-label="Menu" aria-expanded="false"><span></span><span></span><span></span></button>
    <nav class="nav" aria-label="Main">
      <ul>
        <li class="has-mega">
          <button class="nav-link" aria-expanded="false" aria-haspopup="true">Treatments <span class="caret" aria-hidden="true"></span></button>
          <!-- Dropdown design by Ellaine: floating white card, prices per treatment, "Which facial" panel -->
          <div class="mega">
            <div class="mega-card">
              {MENU.map((group) => (
                <div class="mega-col">
                  <h4>{group.title}</h4>
                  {group.items.map((it) => (
                    <a class="mrow" href={it.page ? href(it.page) : '#'} aria-current={it.page && it.page === page ? 'page' : undefined}>
                      <span>{it.label}</span>
                      {it.from && <span class="p">From {it.from}</span>}
                    </a>
                  ))}
                </div>
              ))}
              <div class="mega-side">
                <p class="ms-title">Which facial is right for you?</p>
                <p class="ms-copy">Each facial brand we use does something different. Start with your main concern, and we'll fine-tune it at your appointment.</p>
                <a class="link-arrow" href="#">Compare our facials</a>
                <p class="ms-made">Made for you: <a href="#">Teens</a> · <a href="#">Men</a></p>
              </div>
            </div>
          </div>
        </li>
        <li><a class="nav-link" href="#">Teens</a></li>
        <li><a class="nav-link" href="#">Men</a></li>
        <li><a class="nav-link" href="#">Offers &amp; Gifts</a></li>
        <li><a class="nav-link" href={anchor('#about')}>About</a></li>
        <li><a class="nav-link" href={anchor('#visit')}>Contact</a></li>
      </ul>
      <a class="btn book" href="#">Book Now</a>
    </nav>
  </div>
</header>
