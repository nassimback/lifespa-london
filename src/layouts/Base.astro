---
// Shared page shell for every page.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import { FONTS, type PageId } from '../data/site';

interface Props {
  title: string;
  description: string;
  page: PageId;
}
const { title, description, page } = Astro.props;

// Cache-busting: a new value on every build so browsers always load the latest CSS/JS.
const v = Date.now().toString(36);
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href={FONTS} rel="stylesheet">
  <link rel="stylesheet" href={`css/style.css?v=${v}`}>
  <link rel="stylesheet" href={`css/home-v2.css?v=${v}`}>
  <link rel="stylesheet" href={`css/site.css?v=${v}`}>
</head>
<body class="v2">
  <a class="skip" href="#main">Skip to content</a>

  <div class="announce">✦ West Spa of the Year · The London Hair &amp; Beauty Awards ✦</div>

  <Header page={page} />

  <slot />

  <Footer page={page} />
  <WhatsApp />

  <script is:inline src={`js/main.js?v=${v}`}></script>
  <script is:inline src={`js/reveal.js?v=${v}`}></script>
</body>
</html>
